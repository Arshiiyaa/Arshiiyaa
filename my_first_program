/*

triangles funcation!

*/
int  triangles(int first,int second,int third)
{
  printf("\tplease enter the first side :  ");
  scanf("\t%d",&first);
  
  printf("\tsecond side :  ");
  scanf("%d",&second);
  
  printf("\tand thirs side :  ");
  scanf("%d",&third);
  //
  if((first+second<third)||(first+third<second)||(second+third<first))
  {
      printf("\t×this is not a triangle!!×\n");
      }
      //
      else {
 	if(((first*first)+(second*second)==(third*third))||((second*second)+(third*third)==(first*first))||((first*first)+(third*third)==(second*second)))
 	{
	    printf("\n\t•this is a phythagoras(قائم الزاویه) triangle\n");
 	}
 	 else if((first==second)&&(first==third)&&(second==third))
 	{
 	    printf("\n\t•this is a Equilateral(متوازی الا ضلاع)\ttriangle\n");
 	}
    else if((first==second&&first!=third)||(first==third&&first!=second)||(second==third&&second!=first))
 	{
 	    printf("\t•this is a Isosceles(متوازی الثاقین) triangle\n");
 	}
else 
{
    printf("\t•it doesnt have name\n");
}
}
}
